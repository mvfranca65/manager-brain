+  } catch (erro) {
+    // Continua retornando false (nao ha como comparar), mas AGORA e visivel.
+    logger?.warn(
+      `Comparacao de versao falhou — tratando como "sem atualizacao". ` +
+        `versaoNova=${versaoNova} versaoAtual=${versaoAtual} ` +
